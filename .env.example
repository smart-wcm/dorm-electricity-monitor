# 复制本文件为 .env 并填写真实信息（.env 已被 .gitignore 排除，不会提交到 Git）
# 该接口在校园网内仅凭 roomId 即可取数，无需任何登录凭证（JWT）。
#
# 💡 最省事的方式：直接双击打包后的 exe，首次启动会弹出图形配置向导，
#    按提示填写并点「测试连接」即可，无需手动编辑本文件。

# ===== 1. 宿舍房间号 roomId（创新港，ProxyPin 抓包请求 URL 里的 roomId 参数） =====
XJTU_ROOM_ID=<你的roomId>

# ===== 2. 收件邮箱（接收所有通知/报告的邮箱） =====
#   填你实际使用的邮箱，例如 123456@qq.com；可以和发件账号相同（自收发）。
XJTU_RECIPIENT=you@example.com

# ===== 3. SMTP 邮件发送配置（发件邮箱） =====
#   本项目用 Python 内置 smtplib 发信，可打包进 exe，无需 Node.js / agently-cli。
#   常见服务商预设：
#     QQ 邮箱:   SMTP_HOST=smtp.qq.com   SMTP_PORT=465  SMTP_TLS=ssl
#     163 邮箱:  SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_TLS=ssl
#     Gmail:     SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_TLS=starttls
#     Outlook:   SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_TLS=starttls
#
#   ⚠️ 授权码（SMTP_PASS）不是登录密码！需到对应邮箱网页开启 SMTP 服务后获取：
#      QQ 邮箱：设置 → 账户 → 开启「SMTP服务」→ 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_TLS=ssl
SMTP_USER=you@example.com
SMTP_PASS=<你的SMTP授权码>
# 发件人地址；多数服务商要求等于 SMTP_USER，留空则用 SMTP_USER
SMTP_FROM=

# ===== 4. 可选参数（不填则用程序内置默认值；填了会覆盖默认） =====
#   也可以在图解配置向导的「高级参数」页里填写，效果相同。
# THRESHOLD=10.0               # 低余额预警线（元），余额低于此值发预警邮件
# PRICE_PER_KWH=0.0            # 电价（元/度），填了会把金额折算成「度」，不知道留 0
# REPORT_CYCLE_DAYS=7          # 周报周期（天），每隔几天发一次周报
# MONTHLY_CYCLE_DAYS=30        # 月报周期（天），每隔几天发一次月报
# RETENTION_DAYS=100           # 历史存档保留天数（仅保留最近 N 天）
# ANOMALY_MIN_SAMPLES=20       # 启用异常检测所需的最少记录数
# ANOMALY_MULTIPLE=3.0         # 日耗电 ≥ 基线中位数的 N 倍视为异常
# ANOMALY_MIN_USAGE=5.0        # 单次消耗低于此值（元）不报异常
# ANOMALY_COOLDOWN_DAYS=1      # 异常邮件最短间隔（天）
# RECHARGE_CAP_MULT=2.0        # 图表中充值柱高度封顶倍数
# XJTU_SERVE_PORT=8765         # 实时网页服务端口
# XJTU_SERVE_HOST=127.0.0.1    # 实时网页服务绑定地址：
#                              #   127.0.0.1 = 仅本机可访问（默认，最安全）
#                              #   0.0.0.0   = 局域网内其它设备也可访问（无鉴权，请自行权衡）
# XJTU_INTERVAL_HOURS=6        # 抓取循环间隔（小时），最小 0.5；勿设太小以免频繁打扰校内接口
# XJTU_LOCAL_URL=              # 网页服务地址，一般无需设置（自动生成）

# ============================================================
# 说明：
# - 配置优先级：.env > 系统环境变量 > 代码内置默认值。
# - 发件人 = SMTP_USER（你开启 SMTP 服务的邮箱）；收件人 = 上方 XJTU_RECIPIENT。
# - .env 与 exe/脚本同目录即可，无需设置系统环境变量。
# ============================================================
